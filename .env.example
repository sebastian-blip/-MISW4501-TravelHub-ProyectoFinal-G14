# Copy to `.env` and fill secrets (`.env` is gitignored).
# Used by docker-compose.full-stack.yml and scripts/full-stack-seed-and-smoke.sh

POSTGRES_HOST=misw4502-instance-1.cdw0y8eko0h9.us-east-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Only used by scripts/full-stack-seed-and-smoke.sh (psql), not by service-core.
# require | disable
POSTGRES_SSL=require

# Kafka (full-stack): default PLAINTEXT to docker kafka — leave USER/PASS empty.
# For MSK: KAFKA_BOOTSTRAP_SERVERS=... KAFKA_USERNAME=... KAFKA_PASSWORD=...
# FULL_STACK_CORE_KAFKA=true
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# TH_MOCK_RESERVATION_EXISTS_RATE=0
